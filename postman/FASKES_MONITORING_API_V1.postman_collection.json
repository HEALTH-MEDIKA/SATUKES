{
  "info": {
    "_postman_id": "5286de87-4968-4bf9-a643-11368e035266",
    "name": "Faskes Monitoring API v1 - Web Crypto",
    "description": "Collection pengujian REST API Monitoring Faskes tanpa package NPM. Script memakai Web Crypto bawaan Postman untuk HKDF-SHA256, HMAC-SHA256, dan AES-256-GCM. Isi base_url, cons_id, dan secret_key pada environment sebelum menjalankan request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.request.method !== 'GET') {",
          "    const encoder = new TextEncoder();",
          "    const consId = String(pm.environment.get('cons_id') || '').trim();",
          "    const secret = String(pm.environment.get('secret_key') || '');",
          "",
          "    if (!consId || !secret) {",
          "        throw new Error('Isi cons_id dan secret_key pada environment Faskes Monitoring API terlebih dahulu.');",
          "    }",
          "    if (secret.length < 32) {",
          "        throw new Error('secret_key tidak valid: panjang minimal 32 karakter.');",
          "    }",
          "    if (typeof crypto === 'undefined' || !crypto.subtle) {",
          "        throw new Error('Web Crypto tidak tersedia. Perbarui Postman Desktop ke versi terbaru.');",
          "    }",
          "",
          "    const resolvedUrl = pm.variables.replaceIn(pm.request.url.toString()).split('?')[0].replace(/\\/$/, '');",
          "    const supportedPaths = ['/api/v1/auth/token', '/api/v1/monitoring/kunjungan/summary'];",
          "    const canonicalPath = supportedPaths.find(function (path) { return resolvedUrl.endsWith(path); });",
          "    if (!canonicalPath) {",
          "        throw new Error('Canonical path tidak dikenali: ' + resolvedUrl);",
          "    }",
          "",
          "    function bytesToBase64(bytes) {",
          "        let binary = '';",
          "        for (let index = 0; index < bytes.length; index++) binary += String.fromCharCode(bytes[index]);",
          "        return btoa(binary);",
          "    }",
          "",
          "    async function hkdfSha256(keyMaterial, salt, info) {",
          "        const key = await crypto.subtle.importKey('raw', encoder.encode(keyMaterial), 'HKDF', false, ['deriveBits']);",
          "        const bits = await crypto.subtle.deriveBits({",
          "            name: 'HKDF',",
          "            hash: 'SHA-256',",
          "            salt: encoder.encode(salt),",
          "            info: encoder.encode(info)",
          "        }, key, 256);",
          "        return new Uint8Array(bits);",
          "    }",
          "",
          "    async function encryptPayload(payload, context) {",
          "        const keyBytes = await hkdfSha256(secret, consId, 'his-monitoring-api-encryption-v1');",
          "        const key = await crypto.subtle.importKey('raw', keyBytes, { name: 'AES-GCM' }, false, ['encrypt']);",
          "        const iv = crypto.getRandomValues(new Uint8Array(12));",
          "        const aad = encoder.encode(['1', consId, context.timestamp, context.nonce, context.requestId].join('|'));",
          "        const encrypted = new Uint8Array(await crypto.subtle.encrypt({",
          "            name: 'AES-GCM',",
          "            iv: iv,",
          "            additionalData: aad,",
          "            tagLength: 128",
          "        }, key, encoder.encode(JSON.stringify(payload))));",
          "        const tagLength = 16;",
          "        return {",
          "            version: '1',",
          "            alg: 'A256GCM',",
          "            iv: bytesToBase64(iv),",
          "            tag: bytesToBase64(encrypted.slice(encrypted.length - tagLength)),",
          "            ciphertext: bytesToBase64(encrypted.slice(0, encrypted.length - tagLength))",
          "        };",
          "    }",
          "",
          "    function formatDate(date) {",
          "        const year = date.getFullYear();",
          "        const month = String(date.getMonth() + 1).padStart(2, '0');",
          "        const day = String(date.getDate()).padStart(2, '0');",
          "        return [year, month, day].join('-');",
          "    }",
          "",
          "    const context = {",
          "        timestamp: String(Math.floor(Date.now() / 1000)),",
          "        nonce: pm.variables.replaceIn('{{$guid}}').toLowerCase(),",
          "        requestId: pm.variables.replaceIn('{{$guid}}').toLowerCase()",
          "    };",
          "",
          "    let rawBody = '{}';",
          "    if (canonicalPath === '/api/v1/monitoring/kunjungan/summary') {",
          "        const today = new Date();",
          "        const sixDaysAgo = new Date(today.getTime());",
          "        sixDaysAgo.setDate(today.getDate() - 6);",
          "        const dateFrom = String(pm.environment.get('date_from') || '').trim() || formatDate(sixDaysAgo);",
          "        const dateTo = String(pm.environment.get('date_to') || '').trim() || formatDate(today);",
          "        const token = String(pm.environment.get('access_token') || '').trim();",
          "        if (!token) {",
          "            throw new Error('access_token kosong. Jalankan Dapatkan Access Token terlebih dahulu.');",
          "        }",
          "        rawBody = JSON.stringify(await encryptPayload({ date_from: dateFrom, date_to: dateTo }, context));",
          "        pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "    }",
          "",
          "    const bodyHash = new Uint8Array(await crypto.subtle.digest('SHA-256', encoder.encode(rawBody)));",
          "    const bodyHashHex = Array.from(bodyHash).map(function (byte) { return byte.toString(16).padStart(2, '0'); }).join('');",
          "    const canonical = [pm.request.method.toUpperCase(), canonicalPath, consId, context.timestamp, context.nonce, bodyHashHex].join('\\n');",
          "    const signingKeyBytes = await hkdfSha256(secret, consId, 'his-monitoring-api-signing-v1');",
          "    const signingKey = await crypto.subtle.importKey('raw', signingKeyBytes, { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);",
          "    const signature = bytesToBase64(new Uint8Array(await crypto.subtle.sign('HMAC', signingKey, encoder.encode(canonical))));",
          "",
          "    pm.request.body.update(rawBody);",
          "    pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "    pm.request.headers.upsert({ key: 'X-Cons-Id', value: consId });",
          "    pm.request.headers.upsert({ key: 'X-Timestamp', value: context.timestamp });",
          "    pm.request.headers.upsert({ key: 'X-Nonce', value: context.nonce });",
          "    pm.request.headers.upsert({ key: 'X-Request-Id', value: context.requestId });",
          "    pm.request.headers.upsert({ key: 'X-Signature', value: signature });",
          "    pm.variables.set('request_timestamp', context.timestamp);",
          "    pm.variables.set('request_nonce', context.nonce);",
          "    pm.variables.set('request_id', context.requestId);",
          "    pm.variables.set('request_signature', signature);",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const response = pm.response.json();",
          "",
          "if (pm.request.method === 'GET') {",
          "    pm.test('HTTP status 200', function () { pm.response.to.have.status(200); });",
          "    pm.test('API Monitoring tersedia', function () {",
          "        pm.expect(response.status).to.eql(true);",
          "        pm.expect(response.data.api_version).to.eql('v1');",
          "    });",
          "} else if (pm.response.code >= 200 && pm.response.code < 300 && response.version === '1') {",
          "    const encoder = new TextEncoder();",
          "    const decoder = new TextDecoder();",
          "    const consId = String(pm.environment.get('cons_id') || '');",
          "    const secret = String(pm.environment.get('secret_key') || '');",
          "",
          "    function base64ToBytes(value) {",
          "        const binary = atob(value);",
          "        const bytes = new Uint8Array(binary.length);",
          "        for (let index = 0; index < binary.length; index++) bytes[index] = binary.charCodeAt(index);",
          "        return bytes;",
          "    }",
          "",
          "    function concatBytes(first, second) {",
          "        const result = new Uint8Array(first.length + second.length);",
          "        result.set(first, 0);",
          "        result.set(second, first.length);",
          "        return result;",
          "    }",
          "",
          "    async function hkdfSha256(keyMaterial, salt, info) {",
          "        const key = await crypto.subtle.importKey('raw', encoder.encode(keyMaterial), 'HKDF', false, ['deriveBits']);",
          "        const bits = await crypto.subtle.deriveBits({",
          "            name: 'HKDF',",
          "            hash: 'SHA-256',",
          "            salt: encoder.encode(salt),",
          "            info: encoder.encode(info)",
          "        }, key, 256);",
          "        return new Uint8Array(bits);",
          "    }",
          "",
          "    async function decryptPayload(envelope) {",
          "        const keyBytes = await hkdfSha256(secret, consId, 'his-monitoring-api-encryption-v1');",
          "        const key = await crypto.subtle.importKey('raw', keyBytes, { name: 'AES-GCM' }, false, ['decrypt']);",
          "        const aad = encoder.encode([",
          "            '1',",
          "            consId,",
          "            pm.variables.get('request_timestamp'),",
          "            pm.variables.get('request_nonce'),",
          "            pm.variables.get('request_id')",
          "        ].join('|'));",
          "        const encrypted = concatBytes(base64ToBytes(envelope.ciphertext), base64ToBytes(envelope.tag));",
          "        const plaintext = await crypto.subtle.decrypt({",
          "            name: 'AES-GCM',",
          "            iv: base64ToBytes(envelope.iv),",
          "            additionalData: aad,",
          "            tagLength: 128",
          "        }, key, encrypted);",
          "        return JSON.parse(decoder.decode(plaintext));",
          "    }",
          "",
          "    pm.test('HTTP status 200', function () { pm.response.to.have.status(200); });",
          "    const decrypted = await decryptPayload(response);",
          "    pm.environment.set('last_decrypted_response', JSON.stringify(decrypted, null, 2));",
          "",
          "    const resolvedUrl = pm.variables.replaceIn(pm.request.url.toString()).split('?')[0];",
          "    if (resolvedUrl.endsWith('/api/v1/auth/token')) {",
          "        pm.environment.set('access_token', decrypted.access_token);",
          "        pm.environment.set('token_expires_at', decrypted.expires_at);",
          "        pm.test('Access token berhasil didekripsi', function () {",
          "            pm.expect(decrypted.access_token).to.be.a('string').and.not.empty;",
          "        });",
          "    } else {",
          "        pm.test('Total kunjungan tersedia', function () {",
          "            pm.expect(decrypted.metrics.total_visits).to.be.a('number');",
          "        });",
          "    }",
          "",
          "    pm.visualizer.set('<h3>Decrypted response</h3><pre style=\"white-space:pre-wrap\">{{body}}</pre>', {",
          "        body: JSON.stringify(decrypted, null, 2)",
          "    });",
          "    console.log('Decrypted API response:', decrypted);",
          "} else {",
          "    pm.environment.set('last_decrypted_response', JSON.stringify(response, null, 2));",
          "    pm.test('Request berhasil', function () {",
          "        pm.expect.fail((response.error && response.error.code ? response.error.code + ': ' : '') + (response.message || 'API request gagal'));",
          "    });",
          "    console.error('API error:', response);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/health",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "health"]
        },
        "description": "Memastikan REST API, database, dan master key siap. Tidak membutuhkan kredensial."
      },
      "response": []
    },
    {
      "name": "2. Dapatkan Access Token",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Cons-Id", "value": "{{cons_id}}" },
          { "key": "X-Timestamp", "value": "{{request_timestamp}}" },
          { "key": "X-Nonce", "value": "{{request_nonce}}" },
          { "key": "X-Request-Id", "value": "{{request_id}}" },
          { "key": "X-Signature", "value": "{{request_signature}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/token",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "token"]
        },
        "description": "Membuat signature HMAC otomatis. Response AES-256-GCM didekripsi dan access_token disimpan ke environment."
      },
      "response": []
    },
    {
      "name": "3. Ringkasan Kunjungan",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "X-Cons-Id", "value": "{{cons_id}}" },
          { "key": "X-Timestamp", "value": "{{request_timestamp}}" },
          { "key": "X-Nonce", "value": "{{request_nonce}}" },
          { "key": "X-Request-Id", "value": "{{request_id}}" },
          { "key": "X-Signature", "value": "{{request_signature}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date_from\": \"{{date_from}}\",\n  \"date_to\": \"{{date_to}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/monitoring/kunjungan/summary",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "monitoring", "kunjungan", "summary"]
        },
        "description": "Payload tanggal dienkripsi otomatis. Jika tanggal kosong, memakai tujuh hari terakhir. Response didekripsi pada Visualize dan disimpan pada last_decrypted_response."
      },
      "response": []
    }
  ]
}
